# ── Assets et données : JAMAIS commités (voir CLAUDE.md § Règles juridiques) ──
# Resource packs fournis par l'utilisateur (Faithful 32x, packs Mojang, etc.)
/ressourcepacks/
# Sortie de ov-assetimport : assets extraits du jar client vanilla
/run/
# Sortie du data generator officiel Mojang
/data/vanilla/*/generated/
/data/vanilla/*/normalized/
/data/vanilla/*/*.json
# Jars fournis par l'utilisateur
*.jar

# ── Caches binaires générés (le hash est commité, pas le cache) ──
*.ovpack

# Le codec de registres envoyé au client, construit depuis le datapack vanilla.
# Données dérivées de Mojang : régénérées localement par tools/ov_datagen/codec.py,
# jamais commitées — comme tout le reste sous data/vanilla/.
*.nbt

# ── Build ──
/build/
/out/
/cmake-build-*/
CMakeUserPresets.json
compile_commands.json
.cache/

# ── vcpkg ──
/vcpkg/
/vcpkg_installed/

# ── Outils et OS ──
.DS_Store
.idea/
.vscode/
!.vscode/extensions.json
*.swp
perf.data*
*.dSYM/

# Python caches from the measurement scripts.
__pycache__/
*.pyc

# Agent scratch space: settings and the isolated worktrees agents run in.
.claude/
run/reference-*/
# the server's operators, per machine
ops.json
